# Database & Redis (automatically configured by docker-compose for local dev)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/event_album
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 Storage (Required for photo uploads)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=event-album
R2_ENDPOINT_URL=https://<your_account_id>.r2.cloudflarestorage.com

# App Configuration
DOMAIN=localhost:3000
SECRET_KEY=generate_with_openssl_rand_hex_32
MATCH_THRESHOLD=0.45